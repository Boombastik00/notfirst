# бэкенд
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://notfirst:notfirst@127.0.0.1:5432/notfirst

# фронтенд: куда проксировать /api/v1
BACKEND_ORIGIN=http://localhost:8000

# сервис db в docker compose
POSTGRES_USER=notfirst
POSTGRES_PASSWORD=notfirst
POSTGRES_DB=notfirst

# google oauth: создать oauth-клиент в google cloud console (см docs/GOOGLE_OAUTH.md)
# перенаправление: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# адрес который видит браузер
BASE_URL=http://localhost:3000

# подпись state-cookie во время входа, сгенерируй случайную строку
SESSION_COOKIE_SECRET=change-me

# google_sub через запятую кому дать роль admin при входе
ADMIN_GOOGLE_SUBS=

# только для docker-compose.prod.yml (прод с доменом и caddy)
# DOMAIN=nefirst.example
# ACME_EMAIL=ops@nefirst.example
# POSTGRES_PASSWORD=сгенерируй случайную строку
# BASE_URL в проде задаётся сам compose как https://DOMAIN
